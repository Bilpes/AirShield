# Development-only browser voice configuration.
# This file contains no production credentials. Never add real secrets here.
#
# Live voice now defaults to the SAME-ORIGIN proxy: the browser opens
# /edge/ws/voice on the web app's own origin and Next.js forwards it to the
# voice edge. This works on localhost, LAN IPs and HTTPS hosts with no
# cross-origin WebSocket or mixed-content errors. Leave NEXT_PUBLIC_EDGE_WS_URL
# empty to use it. Set an absolute ws:// or wss:// URL only to bypass the
# proxy and dial the edge (or an authenticated gateway) directly.
NEXT_PUBLIC_EDGE_WS_URL=

# Upstream the /edge/* proxy forwards to (resolved when the dev server /
# build starts). Defaults to the edge started by ./run_local.sh on port 8001.
# EDGE_UPSTREAM=http://127.0.0.1:8001

# Permit the local hackathon runtime and insecure localhost WebSocket only.
AIRSHIELD_RUNTIME_MODE=development
AIRSHIELD_ALLOW_DEVELOPMENT_RUNTIME=true
AIRSHIELD_ALLOW_INSECURE_LOCAL_EDGE=true
