ENVIRONMENT=development
ASR_MODEL=small.en
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
LANGUAGE=en
ENABLE_DIARIZATION=false
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
HF_TOKEN=
MODEL_MANIFEST_PATH=/models/manifest.json
MODEL_MANIFEST_SHA256=
MIN_PROCESS_BYTES=32000
PROCESS_INTERVAL_SECONDS=2.5
MAX_AUDIO_BYTES=100000000
MAX_CONCURRENT_INFERENCE=1
ALLOW_ORIGINS=http://localhost:4174

# Production voice protection must use the Python control plane.
CONTROL_PLANE_URL=http://127.0.0.1:8080
# Production uses HTTPS and a mounted private CA.
CONTROL_PLANE_CA_FILE=/var/run/secrets/control-plane-tls/ca.crt
CONTROL_PLANE_DEV_TOKEN=development-only
# Portable projected OIDC token:
CONTROL_PLANE_TOKEN_FILE=
# Azure Workload Identity (webhook supplies tenant/client/federated file):
CONTROL_PLANE_SCOPE=api://airshield-control-plane/.default
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_FEDERATED_TOKEN_FILE=

# Production gateway strips client copies and injects this secret header.
GATEWAY_SHARED_SECRET=
