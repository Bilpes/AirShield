# Browser live-voice path. Empty by default: the browser uses the same-origin
# /edge/ws/voice proxy (Next.js forwards /edge/* to the voice edge — see
# EDGE_UPSTREAM below), which also works on LAN IPs and HTTPS hosts. Set an
# absolute ws:// or wss:// URL only to bypass the proxy; production must then
# use the trusted gateway over WSS.
NEXT_PUBLIC_EDGE_WS_URL=
# Upstream for the same-origin /edge/* voice proxy (resolved at build/dev
# start). Default: http://127.0.0.1:8001 (the edge from ./run_local.sh).
# docker-compose overrides this to http://edge:8001 inside the stack.
# EDGE_UPSTREAM=http://127.0.0.1:8001

# Server-side privacy control. Production route handlers fail closed when this is absent.
CONTROL_PLANE_URL=http://127.0.0.1:8080
# Development only; the dev control plane ignores the placeholder bearer value.
CONTROL_PLANE_DEV_TOKEN=development-only

# Portable Kubernetes: projected service-account/SPIFFE-compatible OIDC JWT.
CONTROL_PLANE_TOKEN_FILE=
# Azure: the Workload Identity webhook sets AZURE_TENANT_ID, AZURE_CLIENT_ID,
# and AZURE_FEDERATED_TOKEN_FILE. Configure the target app scope below.
CONTROL_PLANE_SCOPE=api://airshield-control-plane/.default

# Optional self-hosted Ollama destination. Production fails closed when unavailable.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
