ENVIRONMENT=development
EDGE_WEBSOCKET_URL=ws://airshield-edge:8001/ws/voice
# Production uses wss://airshield-edge:8001/ws/voice and the mounted private CA.
EDGE_CA_FILE=/var/run/secrets/edge-tls/ca.crt
EDGE_GATEWAY_SECRET=development-edge-secret-change-me-123456789
ALLOW_ORIGINS=http://localhost:4174
OIDC_ISSUER=https://login.example.com/TENANT_ID/v2.0
OIDC_AUDIENCE=api://airshield-browser
OIDC_JWKS_URL=https://login.example.com/TENANT_ID/discovery/v2.0/keys
TENANT_CLAIM=tid
EXPECTED_TENANT_ID=REPLACE_TENANT_ID
SPEAKER_TRACK_CLAIM=airshield_speaker_track
SESSION_COOKIE_NAME=airshield_session
DEV_SESSION_TOKEN=development-browser-session
MAX_CONNECTIONS=200
MAX_MESSAGE_BYTES=1048576
MAX_SESSION_AUDIO_BYTES=100000000
MAX_MESSAGES_PER_SECOND=20
MAX_SESSION_SECONDS=3600
FINAL_WAIT_SECONDS=15
