ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://airshield:change-me@localhost:5432/airshield

# Workload identity: Azure Entra or SPIFFE OIDC Discovery Provider.
AUTH_MODE=oidc
OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
OIDC_AUDIENCE=api://airshield-control-plane
OIDC_JWKS_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/discovery/v2.0/keys
TENANT_CLAIM=tid
# Portable projected service-account tokens normally lack tenant/scope claims. Map only exact verified subjects.
WORKLOAD_BINDINGS_JSON={}

# Production: azure or openbao. local is rejected when ENVIRONMENT=production.
KEY_PROVIDER=azure
AZURE_KEY_VAULT_URL=https://YOUR-VAULT.vault.azure.net
AZURE_WRAP_KEY_NAME=airshield-wrap
AZURE_SIGN_KEY_NAME=airshield-receipt-sign

# Cloud-neutral OpenBao Transit alternative.
OPENBAO_ADDR=https://openbao.security.svc:8200
OPENBAO_TOKEN_FILE=/var/run/secrets/openbao/token
OPENBAO_TRANSIT_MOUNT=transit
OPENBAO_WRAP_KEY=airshield-wrap
OPENBAO_SIGN_KEY=airshield-sign

# All providers require an independent random HMAC index key (at least 32 bytes, base64).
TOKEN_INDEX_KEY_B64=

# Development-only local provider. Generate separate 32-byte base64 secrets.
LOCAL_MASTER_KEY_B64=
LOCAL_SIGNING_PRIVATE_KEY_B64=

POLICY_DIRECTORY=/service/policies
FAIL_CLOSED=true
ALLOW_RAW_IN_API=false
MAX_TEXT_BYTES=262144
ALLOWED_ORIGINS=https://airshield.example.com
LOG_LEVEL=INFO

# Evidence contains hashes and metadata only; export to immutable WORM/SIEM storage.
EVIDENCE_RETENTION_DAYS=2555
AUDIT_EXPORT_REQUIRED=true
